{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "bash '/Users/joshka/.codex/herdr-agent-state.sh' blocked",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/joshka/.codex/hooks/deletion-guard.py'",
            "timeout": 10,
            "statusMessage": "Deletion guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/joshka/.codex/herdr-agent-state.sh' working",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/joshka/.codex/herdr-agent-state.sh' idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash '/Users/joshka/.codex/herdr-agent-state.sh' idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash '/Users/joshka/.codex/herdr-agent-state.sh' working",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/joshka/.codex/hooks/mutation-audit.py'",
            "timeout": 10,
            "statusMessage": "Audit"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \".agents/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  }
}