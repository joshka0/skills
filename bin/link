#!/usr/bin/env node
// Rebuild provider links from the manifest. Preserve real entries and move obsolete links to Trash.
import fs from "node:fs"
import path from "node:path"
import { execFileSync } from "node:child_process"
import { fileURLToPath } from "node:url"

const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)))
const manifest = JSON.parse(fs.readFileSync(path.join(root, "manifest.json"), "utf8"))
const skills = fs.readdirSync(path.join(root, "skills"), { withFileTypes: true })
  .filter(e => e.isDirectory() && fs.existsSync(path.join(root, "skills", e.name, "SKILL.md")))
  .map(e => e.name).sort()

try {
  // Check every provider before changing any of them.
  const plans = Object.entries(manifest.providers).map(([provider, spec]) => {
    const dest = path.join(root, "providers", provider)
    const excluded = new Set((spec.exclude ?? []).flatMap(g => manifest[g] ?? [g]))
    const preserve = new Set((spec.preserve ?? []).flatMap(g => manifest[g] ?? [g]))
    const wanted = new Map(skills.filter(n => !excluded.has(n))
      .map(n => [n, path.join("..", "..", "skills", n)]))
    for (const source of spec.native ?? []) {
      if (!fs.existsSync(path.join(root, source, "SKILL.md"))) {
        throw new Error(`missing native package: ${source}`)
      }
      wanted.set(path.basename(source), path.join("..", "..", source))
    }
    for (const name of preserve) wanted.delete(name)
    const entries = fs.existsSync(dest) ? fs.readdirSync(dest) : []
    for (const name of entries) {
      if (!preserve.has(name) && wanted.has(name) &&
          !fs.lstatSync(path.join(dest, name)).isSymbolicLink()) {
        throw new Error(`unmanaged entry conflicts with wanted link: ${provider}/${name}`)
      }
    }
    return { provider, dest, preserve, wanted, entries }
  })

  for (const { provider, dest, preserve, wanted, entries } of plans) {
    fs.mkdirSync(dest, { recursive: true })
    let kept = 0
    for (const name of entries) {
      const full = path.join(dest, name)
      if (preserve.has(name)) {
        kept++
      } else if (fs.lstatSync(full).isSymbolicLink()) {
        if (fs.readlinkSync(full) === wanted.get(name)) {
          wanted.delete(name)
          kept++
        } else {
          execFileSync("/usr/bin/trash", [full])
        }
      } else {
        console.error(`WARN ${provider}: unmanaged real entry left in place: ${name}`)
      }
    }
    for (const [name, target] of wanted) fs.symlinkSync(target, path.join(dest, name))
    console.log(`${provider}: ${kept} kept, ${wanted.size} linked`)
  }
} catch (error) {
  console.error(`ERROR: ${error.message}`)
  process.exitCode = 1
}
