#!/bin/sh
set -eu

if ! command -v kingfisher >/dev/null 2>&1; then
  echo "kingfisher not found; install it or bypass with git commit --no-verify" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

# Keep provider symlink farms in step with skill/manifest changes.
if git diff --cached --name-only | grep -Eq '^(skills/|native/|manifest\.json$)'; then
  node bin/link >/dev/null
fi

exec kingfisher scan \
  --staged \
  --redact \
  --no-validate \
  --confidence medium \
  --format pretty \
  --no-update-check \
  .
