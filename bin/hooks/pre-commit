#!/bin/sh
set -eu

if ! command -v kingfisher >/dev/null 2>&1; then
  echo "kingfisher not found; install it or bypass with git commit --no-verify" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

# Pack gate: source, catalog, native, or governing-doc changes validate the full pack.
if git diff --cached --name-only | grep -Eq '^(shared/|catalog/|native/|README\.md$|PACK\.md$|AGENTS\.md$|packs/joshka0/(README|SOURCE_NOTES)\.md$)'; then
  echo "pack-governed path changed; running bin/pack check" >&2
  bin/pack check
fi

exec kingfisher scan \
  --staged \
  --redact \
  --no-validate \
  --confidence medium \
  --format pretty \
  --no-update-check \
  .
