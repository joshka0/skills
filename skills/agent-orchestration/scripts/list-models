#!/usr/bin/env bash
# Print the live model IDs of each installed harness, for resolving the newest ID of a models.md line.
# Read-only. Never prints credentials. A missing CLI or a failed probe prints "unknown".
set -u

probe() { timeout 45 "$@" 2>&1; }
have() { command -v "$1" >/dev/null 2>&1; }
section() { printf '\n## %s\n' "$1"; }

section "codex (codex debug models; lower priority = preferred)"
if have codex; then
  probe codex debug models | jq -r '.. | objects | select(has("slug") and .visibility == "list")
    | "\(.priority)\t\(.slug)\t\(.description // "")"' | sort -n || echo unknown
else echo "unknown: codex missing"; fi

section "pi (pi --list-models; default from ~/.pi/agent/settings.json)"
if have pi; then
  jq -r '"default: \(.defaultProvider)/\(.defaultModel)"' "$HOME/.pi/agent/settings.json" 2>/dev/null
  probe pi --list-models | awk 'NR>1 {print $1"/"$2}' || echo unknown
else echo "unknown: pi missing"; fi

section "opencode (opencode models; openrouter omitted)"
if have opencode; then
  probe opencode models | grep -v '^openrouter/' || echo unknown
else echo "unknown: opencode missing"; fi

section "droid (custom model IDs from ~/.factory/settings.json)"
if have droid; then
  jq -r '(.customModels // [])[] | "\(.id)\t\(.model)\t\(.displayName // "")"' "$HOME/.factory/settings.json" 2>/dev/null || echo unknown
else echo "unknown: droid missing"; fi

section "cursor-agent (cursor-agent --list-models)"
if have cursor-agent; then probe cursor-agent --list-models | head -60; else echo "unknown: cursor-agent missing"; fi

section "devin (devin models list)"
if have devin; then probe devin models list | grep -E '^[^ ].*\(.*\)$'; else echo "unknown: devin missing"; fi

section "grok (grok models)"
if have grok; then probe grok models | head -20; else echo "unknown: grok missing"; fi

section "claude accounts (CLAUDE_CONFIG_DIR per alias; no list command: use the claude-api skill or Exa)"
for dir in "$HOME"/.claude "$HOME"/.claude-*; do
  [ -f "$dir/settings.json" ] && printf '%s\tmodel=%s\n' "$dir" "$(jq -r '.model // "default"' "$dir/settings.json" 2>/dev/null)"
done
